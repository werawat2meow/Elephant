# Additional settings for the staff-review, email and payment workflow.
# This file is not loaded automatically. Add the required entries to .env.local
# alongside the original .env.example settings; preserve any existing real values.

PAYMENTS_ENABLED=false

# Staff login (JWT, no database).
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# At least 32 random characters; may fall back to a sufficiently long NEXTAUTH_SECRET.
BOOKING_TICKET_SECRET=

# Resend: verified sender, with optional reply-to address.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# Verified public business details; blank fields stay hidden.
NEXT_PUBLIC_LEGAL_OPERATOR=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_CONTACT_HOURS=
NEXT_PUBLIC_LINE_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# Optional Google integrations.
GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
